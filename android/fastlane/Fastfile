default_platform(:android)

platform :android do
  lane :deploy do
    upload_to_play_store(
        aab: "../build/app/outputs/bundle/release/app-release.aab",
        release_status: "draft",
        track: "internal",
        timeout: 1200,
    )
    download_universal_apk_from_google_play(
        version_code: ##version_code##,
        destination: "../../output/KingVPN-android-universal.apk",
    )
  end

  # Local GitHub release lane (no Play Store account needed):
  # builds a signed universal APK from the same upload keystore.
  lane :github do
    sh("flutter build apk --release --target-platform android-arm64,android-x64")
    FileUtils.mkdir_p("../../output")
    FileUtils.cp(
      "../build/app/outputs/flutter-apk/app-release.apk",
      "../../output/KingVPN-android-universal.apk",
    )
  end
end
